# SignalSentinel environment variables
# Copy to .env and fill in your key

# Groq (recommended) — OpenAI-compatible, fast, free tier
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Or generic OpenAI-compatible provider
SENTINEL_API_KEY=
SENTINEL_BASE_URL=https://api.groq.com/openai/v1
SENTINEL_MODEL=llama-3.3-70b-versatile